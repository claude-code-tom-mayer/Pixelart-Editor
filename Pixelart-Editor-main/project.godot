; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to the same key/value pair as before the section
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixelart-Editor"
run/main_scene="res://Tests/EndToEndTest.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

G_ChunkingServer="*res://Servers/Chunking/G_ChunkingServer.gd"
G_HitServer="*res://Servers/Hit/G_HitServer.gd"
G_TargetingServer="*res://Servers/Targeting/G_TargetingServer.gd"
