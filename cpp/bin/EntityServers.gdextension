[configuration]

entry_symbol = "entity_servers_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

linux.debug.x86_64     = "res://cpp/bin/libentityservers.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://cpp/bin/libentityservers.linux.template_release.x86_64.so"
windows.debug.x86_64   = "res://cpp/bin/libentityservers.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://cpp/bin/libentityservers.windows.template_release.x86_64.dll"
macos.debug            = "res://cpp/bin/libentityservers.macos.template_debug.framework"
macos.release          = "res://cpp/bin/libentityservers.macos.template_release.framework"
android.debug.arm64    = "res://cpp/bin/libentityservers.android.template_debug.arm64.so"
android.release.arm64  = "res://cpp/bin/libentityservers.android.template_release.arm64.so"
